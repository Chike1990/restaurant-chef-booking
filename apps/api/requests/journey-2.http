Authorization: Bearer {{accessToken}}

{ "method": "card", "details": { "cardNumber": "4111111111111111" } }

### Balance should now be 5 — enough stamps for a reward.
GET {{host}}/api/loyalty/me
Authorization: Bearer {{accessToken}}

### Redeem: converts 5 stamps into one issued reward row.
# @name redeem
POST {{host}}/api/loyalty/redeem
Authorization: Bearer {{accessToken}}

### Order 6: apply the reward at checkout. discountKobo on this order
### should equal its one unit's price, and totalKobo should be reduced by
### exactly that much.
# @name order6
POST {{host}}/api/orders
Content-Type: application/json
Idempotency-Key: {{$guid}}
Authorization: Bearer {{accessToken}}

{
  "fulfilment": "pickup",
  "branchId": "{{branchId}}",
  "rewardApplied": true,
  "lines": [{ "menuItemId": "{{menuItemId}}", "optionIds": ["{{swallowOptionId}}", "{{proteinOptionId}}"], "quantity": 1 }]
}

### Confirm: balance is back to 0 (5 earned, 5 spent on the redeem above),
### and rewardsAvailable no longer lists the one just applied.
GET {{host}}/api/loyalty/me
Authorization: Bearer {{accessToken}}
