### Journey 2: five qualifying orders -> a reward becomes redeemable ->
### redeem it -> apply it at checkout on a sixth order.
#
# Same prerequisite as journey-1.http: paste real ids below first.

@host = http://localhost:3000

@branchId = REPLACE_WITH_AWKA_BRANCH_ID
@menuItemId = REPLACE_WITH_OFE_ONUGBU_ID
@swallowOptionId = REPLACE_WITH_EBA_OPTION_ID
@proteinOptionId = REPLACE_WITH_GOAT_MEAT_OPTION_ID

### Register once — every order and the redeem below belongs to this user.
# @name register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "journey2-{{$guid}}@example.com",
  "password": "correct-horse-battery-staple",
  "fullName": "Journey Two Tester",
  "phone": "0803 123 4567"
}

###
@accessToken = {{register.response.body.$.accessToken}}

### --- Order 1 of 5: pickup, one qualifying unit = one stamp. ---
# @name order1
POST {{host}}/api/orders
Content-Type: application/json
Idempotency-Key: {{$guid}}
Authorization: Bearer {{accessToken}}

{
  "fulfilment": "pickup",
  "branchId": "{{branchId}}",
  "lines": [{ "menuItemId": "{{menuItemId}}", "optionIds": ["{{swallowOptionId}}", "{{proteinOptionId}}"], "quantity": 1 }]
}

###
POST {{host}}/api/orders/{{order1.response.body.$.order.id}}/pay
Content-Type: application/json
Idempotency-Key: {{$guid}}
Authorization: Bearer {{accessToken}}

{ "method": "card", "details": { "cardNumber": "4111111111111111" } }

