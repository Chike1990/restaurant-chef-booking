# Copy to .env and adjust. .env is gitignored — never commit real credentials.
# Docker Compose reads this file too, so the Postgres and MinIO values below are
# what the containers are created with.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres — these three feed both the container and DATABASE_URL below.
# Host port is 5433: a Homebrew postgres already holds 5432 on this machine.
POSTGRES_USER=golden_spoon
POSTGRES_PASSWORD=golden_spoon
POSTGRES_DB=golden_spoon
DATABASE_URL=postgresql://golden_spoon:golden_spoon@localhost:5433/golden_spoon

# LocalStack provides S3 locally (MinIO images are no longer pullable).
S3_ENDPOINT=http://localhost:4566
S3_REGION=eu-west-2
S3_BUCKET=golden-spoon-media
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# Comma-separated origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173
